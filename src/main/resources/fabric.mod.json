{
	"schemaVersion": 1,
	"id": "argent",
	"version": "${version}",
	"name": "Argent",
	"description": "Silver, and the things it lets you see. Mirrors with a built-in skin editor, soul lanterns that show where monsters can spawn, and Scrying, which lets you see and move as your wolf or parrot.",
	"authors": [
		"khrux"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/argent",
		"sources": "https://github.com/Khrux/argent",
		"issues": "https://github.com/Khrux/argent/issues"
	},
	"license": "CC-BY-NC-SA-4.0",
	"icon": "assets/argent/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.khrux.argent.Argent"
		],
		"client": [
			"com.khrux.argent.client.ArgentClient"
		],
		"fabric-datagen": [
			"com.khrux.argent.datagen.ArgentDataGenerator"
		],
		"modmenu": [
			"com.khrux.argent.client.ArgentModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"mixins": [
		"argent.mixins.json",
		{
			"config": "argent.client.mixins.json",
			"environment": "client"
		}
	]
}
